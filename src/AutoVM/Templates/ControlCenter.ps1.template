<#
    AutoVM Control Center
    Generated by AutoVM for the virtual machine "{{VMNAME}}".

    Start, configure, shut down and roll back the machine without a terminal.
#>
Add-Type -AssemblyName System.Windows.Forms, System.Drawing
$ErrorActionPreference = 'Stop'

$VM        = '{{VMNAME}}'
$GuestName = '{{GUESTNAME}}'
$LoginName = '{{USERNAME}}'
$Snapshot  = '{{SNAPSHOT}}'

function Get-VBox {
    try { (Get-ItemProperty 'HKLM:\SOFTWARE\Oracle\VirtualBox' -ErrorAction Stop).InstallDir }
    catch { $null }
}

$VBoxDir = Get-VBox
$VBM = if ($VBoxDir) { Join-Path $VBoxDir 'VBoxManage.exe' } else { 'VBoxManage.exe' }
$GUI = if ($VBoxDir) { Join-Path $VBoxDir 'VirtualBox.exe' } else { 'VirtualBox.exe' }

function Get-VMState {
    try {
        $line = & $VBM showvminfo $VM --machinereadable 2>$null | Select-String '^VMState='
        if (-not $line) { return 'not found' }
        return ($line -replace '.*"(.*)".*', '$1')
    } catch { 'unavailable' }
}

$form                 = New-Object Windows.Forms.Form
$form.Text            = 'AutoVM Control Center'
$form.Size            = New-Object Drawing.Size(450, 372)
$form.StartPosition   = 'CenterScreen'
$form.FormBorderStyle = 'FixedSingle'
$form.MaximizeBox     = $false
$form.BackColor       = [Drawing.Color]::FromArgb(16, 20, 32)

$lblTitle           = New-Object Windows.Forms.Label
$lblTitle.Text      = $GuestName.ToUpperInvariant()
$lblTitle.Font      = New-Object Drawing.Font('Segoe UI Semibold', 16)
$lblTitle.ForeColor = [Drawing.Color]::FromArgb(120, 200, 255)
$lblTitle.Location  = New-Object Drawing.Point(20, 14)
$lblTitle.AutoSize  = $true
$form.Controls.Add($lblTitle)

$lblSub           = New-Object Windows.Forms.Label
$lblSub.Text      = "machine: $VM"
$lblSub.Font      = New-Object Drawing.Font('Consolas', 8.5)
$lblSub.ForeColor = [Drawing.Color]::FromArgb(130, 145, 170)
$lblSub.Location  = New-Object Drawing.Point(22, 46)
$lblSub.Size      = New-Object Drawing.Size(390, 18)
$form.Controls.Add($lblSub)

$lblState           = New-Object Windows.Forms.Label
$lblState.Location  = New-Object Drawing.Point(22, 66)
$lblState.Size      = New-Object Drawing.Size(390, 22)
$lblState.Font      = New-Object Drawing.Font('Consolas', 10)
$lblState.ForeColor = [Drawing.Color]::Gainsboro
$form.Controls.Add($lblState)

function New-ActionButton($text, $x, $y, $w, $action, $accent) {
    $b           = New-Object Windows.Forms.Button
    $b.Text      = $text
    $b.Location  = New-Object Drawing.Point($x, $y)
    $b.Size      = New-Object Drawing.Size($w, 42)
    $b.FlatStyle = 'Flat'
    $b.BackColor = if ($accent) { [Drawing.Color]::FromArgb(64, 40, 46) } else { [Drawing.Color]::FromArgb(40, 46, 62) }
    $b.ForeColor = if ($accent) { [Drawing.Color]::FromArgb(255, 180, 170) } else { [Drawing.Color]::White }
    $b.Font      = New-Object Drawing.Font('Segoe UI', 9.5)
    $b.FlatAppearance.BorderColor = [Drawing.Color]::FromArgb(58, 66, 86)
    $b.Add_Click($action)
    $form.Controls.Add($b)
    $b
}

New-ActionButton 'Start (Window)'      22 100 190 { & $VBM startvm $VM --type gui } $false | Out-Null
New-ActionButton 'Start (Headless)'   222 100 190 { & $VBM startvm $VM --type headless } $false | Out-Null
New-ActionButton 'Settings...'         22 150 190 { Start-Process $GUI -ArgumentList '--startvm-settings', $VM } $false | Out-Null
New-ActionButton 'VirtualBox Manager' 222 150 190 { Start-Process $GUI } $false | Out-Null
New-ActionButton 'Shut Down'           22 200 190 { & $VBM controlvm $VM acpipowerbutton } $false | Out-Null
New-ActionButton 'Save State'         222 200 190 { & $VBM controlvm $VM savestate } $false | Out-Null

New-ActionButton 'Restore to first-boot state' 22 250 390 {
    $answer = [Windows.Forms.MessageBox]::Show(
        "This returns $VM to the state it was in right after it was built.`n`nEverything saved inside the virtual machine since then is discarded. Continue?",
        'Restore restore point', 'YesNo', 'Warning')
    if ($answer -eq 'Yes') {
        & $VBM controlvm $VM poweroff 2>$null
        Start-Sleep -Seconds 3
        & $VBM snapshot $VM restore $Snapshot
        [Windows.Forms.MessageBox]::Show("$VM has been restored.", 'AutoVM', 'OK', 'Information') | Out-Null
    }
} $true | Out-Null

$lblLogin           = New-Object Windows.Forms.Label
$lblLogin.Text      = "  sign in as  $LoginName   (case-sensitive)"
$lblLogin.Location  = New-Object Drawing.Point(22, 302)
$lblLogin.Size      = New-Object Drawing.Size(390, 20)
$lblLogin.Font      = New-Object Drawing.Font('Consolas', 9)
$lblLogin.ForeColor = [Drawing.Color]::FromArgb(130, 145, 170)
$lblLogin.BackColor = [Drawing.Color]::FromArgb(24, 29, 44)
$lblLogin.TextAlign = 'MiddleLeft'
$form.Controls.Add($lblLogin)

$timer          = New-Object Windows.Forms.Timer
$timer.Interval = 2000
$timer.Add_Tick({
        $s = Get-VMState
        $lblState.Text = "  status:  $s"
        $lblState.ForeColor = switch -Regex ($s) {
            'running'          { [Drawing.Color]::FromArgb(95, 217, 166) }
            'saved|paused'     { [Drawing.Color]::Gold }
            'poweroff|aborted' { [Drawing.Color]::IndianRed }
            default            { [Drawing.Color]::Gray }
        }
    })
$timer.Start()

[void]$form.ShowDialog()
