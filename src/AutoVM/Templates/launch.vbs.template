' Launches the AutoVM Control Center without flashing a console window.
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

script = "{{SCRIPTPATH}}"
shell = "powershell.exe"
If fso.FileExists(sh.ExpandEnvironmentStrings("%ProgramFiles%\PowerShell\7\pwsh.exe")) Then
  shell = "pwsh.exe"
End If

sh.Run shell & " -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & script & """", 0, False
