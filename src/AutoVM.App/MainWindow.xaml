<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoVM" Height="660" Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0B1020"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Ink"      Color="#0B1020"/>
    <SolidColorBrush x:Key="Panel"    Color="#131B32"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#18213C"/>
    <SolidColorBrush x:Key="Line"     Color="#26314F"/>
    <SolidColorBrush x:Key="Text"     Color="#E8EEF9"/>
    <SolidColorBrush x:Key="Muted"    Color="#93A3C0"/>
    <SolidColorBrush x:Key="Accent"   Color="#3E8BFF"/>
    <SolidColorBrush x:Key="Ok"       Color="#3FD69B"/>
    <SolidColorBrush x:Key="Warn"     Color="#F0B84E"/>
    <SolidColorBrush x:Key="Bad"      Color="#FF6B5E"/>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Deck" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#243154"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="#5AA0FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0E1730"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#0E1730"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= SIDEBAR ================= -->
    <Border Grid.Column="0" Background="#080D1B">
      <StackPanel Margin="24,28">
        <TextBlock Text="AutoVM" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="virtual machines, set up for you" Foreground="{StaticResource Muted}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,2,0,26"/>

        <TextBlock x:Name="StepWelcome" Text="1   Welcome"        Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>
        <TextBlock x:Name="StepDevice"  Text="2   This device"    Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>
        <TextBlock x:Name="StepAccount" Text="3   Your account"   Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>
        <TextBlock x:Name="StepReview"  Text="4   Review"         Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>
        <TextBlock x:Name="StepBuild"   Text="5   Building"       Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>
        <TextBlock x:Name="StepDone"    Text="6   Ready"          Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,7" FontFamily="Consolas"/>

        <Border Height="1" Background="{StaticResource Line}" Margin="0,26,0,14"/>
        <TextBlock x:Name="SidebarNote" Foreground="#6C7DA0" FontSize="10.5" TextWrapping="Wrap"
                   Text="AutoVM leaves your existing machines and your security settings alone unless you tell it otherwise."/>
      </StackPanel>
    </Border>

    <!-- ================= CONTENT ================= -->
    <Grid Grid.Column="1" Margin="34,30,34,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">

        <!-- ========== 1 WELCOME ========== -->
        <StackPanel x:Name="PageWelcome" Visibility="Visible">
          <TextBlock Style="{StaticResource H1}" Text="Set up a Linux virtual machine"/>
          <TextBlock Style="{StaticResource Deck}"
                     Text="AutoVM looks at this computer, works out a machine that will run well on it, downloads a verified system image, and installs it without you having to answer installer questions. You choose the login and password; everything else is decided for you."/>
          <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="20" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10" Text="What happens next"/>
              <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,5"
                         Text="1.  AutoVM checks that this computer can run a virtual machine at all."/>
              <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,5"
                         Text="2.  You pick the system and type the login and password you want inside it."/>
              <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,5"
                         Text="3.  You see exactly what will be created before anything is installed."/>
              <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" FontSize="12.5"
                         Text="4.  AutoVM builds it and puts a control panel on your desktop. Expect 30 to 90 minutes."/>
            </StackPanel>
          </Border>
          <Border Background="#1B2038" CornerRadius="8" Padding="16,13" BorderBrush="#3A3050" BorderThickness="1" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Muted}"
                       Text="AutoVM needs administrator rights to install the virtualization software, and it downloads several gigabytes. It will not change your firewall, your Windows security settings, or any virtual machine you already have."/>
          </Border>
        </StackPanel>

        <!-- ========== 2 DEVICE ========== -->
        <Grid x:Name="PageDevice" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="This device"/>
            <TextBlock Style="{StaticResource Deck}" x:Name="DeviceDeck"
                       Text="Checking what this computer can do."/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="4"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,20">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GateList" Margin="14,12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Mark}" Foreground="{Binding Colour}"
                                   FontSize="14" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" Foreground="#E8EEF9" FontSize="13"/>
                          <TextBlock Text="{Binding Detail}" Foreground="#7E8DAB" FontSize="11.5"
                                     FontFamily="Consolas" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Advice}" Foreground="{Binding Colour}" FontSize="12"
                                     TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding AdviceVisible}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <StackPanel Grid.Column="1">
              <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Text="DEVICE"/>
                  <TextBlock x:Name="DeviceModel" Style="{StaticResource Body}" Margin="0,0,0,12" Text="-"/>
                  <TextBlock Style="{StaticResource Label}" Text="MEMORY"/>
                  <TextBlock x:Name="DeviceRam" Style="{StaticResource Body}" Margin="0,0,0,12" Text="-"/>
                  <TextBlock Style="{StaticResource Label}" Text="PROCESSOR"/>
                  <TextBlock x:Name="DeviceCpu" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,12" Text="-"/>
                  <TextBlock Style="{StaticResource Label}" Text="FREE SPACE"/>
                  <TextBlock x:Name="DeviceDisk" Style="{StaticResource Body}" Text="-"/>
                </StackPanel>
              </Border>
              <Button x:Name="BtnRescan" Content="Check again" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ========== 3 ACCOUNT ========== -->
        <StackPanel x:Name="PageAccount" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Your account inside the machine"/>
          <TextBlock Style="{StaticResource Deck}"
                     Text="This is the login you will use every time you start the virtual machine. AutoVM does not store the password anywhere - it goes straight into the installation and is then erased."/>

          <TextBlock Style="{StaticResource Label}" Text="SYSTEM"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="GuestKali" Content="Kali Linux" GroupName="Guest" IsChecked="True" Margin="0,0,26,0"/>
            <RadioButton x:Name="GuestDebian" Content="Debian" GroupName="Guest"/>
          </StackPanel>
          <TextBlock x:Name="GuestBlurb" Style="{StaticResource Body}" Foreground="{StaticResource Muted}"
                     FontSize="12" Margin="0,-12,0,18" Text=""/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Label}" Text="LOGIN NAME"/>
              <TextBox x:Name="TxtUser" MaxLength="32"/>
              <TextBlock x:Name="UserHint" Style="{StaticResource Body}" FontSize="11.5" Margin="0,6,0,0"
                         Foreground="{StaticResource Muted}" Text="Letters, digits, hyphen and underscore."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Label}" Text="MACHINE NAME (OPTIONAL)"/>
              <TextBox x:Name="TxtVmName" MaxLength="48"/>
              <TextBlock Style="{StaticResource Body}" FontSize="11.5" Margin="0,6,0,0"
                         Foreground="{StaticResource Muted}" Text="How the machine is listed in VirtualBox."/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Label}" Text="PASSWORD"/>
              <PasswordBox x:Name="TxtPass"/>
              <Border Height="5" Background="#0E1730" CornerRadius="3" Margin="0,8,0,0">
                <Border x:Name="StrengthBar" HorizontalAlignment="Left" Width="0" Background="{StaticResource Bad}" CornerRadius="3"/>
              </Border>
              <TextBlock x:Name="PassHint" Style="{StaticResource Body}" FontSize="11.5" Margin="0,6,0,0"
                         Foreground="{StaticResource Muted}" Text=""/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Label}" Text="CONFIRM PASSWORD"/>
              <PasswordBox x:Name="TxtPass2"/>
              <TextBlock x:Name="Pass2Hint" Style="{StaticResource Body}" FontSize="11.5" Margin="0,6,0,0"
                         Foreground="{StaticResource Bad}" Text=""/>
            </StackPanel>
          </Grid>

          <Border Background="#1B2038" CornerRadius="8" Padding="16,13" BorderBrush="#3A3050" BorderThickness="1" Margin="0,20,0,0">
            <TextBlock x:Name="CaseNote" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Muted}"
                       Text="Linux logins are case-sensitive. Whatever you type here is exactly what you will type to sign in."/>
          </Border>
        </StackPanel>

        <!-- ========== 4 REVIEW ========== -->
        <Grid x:Name="PageReview" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="Before anything is installed"/>
            <TextBlock Style="{StaticResource Deck}" Text="This is what AutoVM will create on this device."/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
              <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="20"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Label}" Text="SYSTEM"/>
                    <TextBlock x:Name="RvGuest" Style="{StaticResource Body}" Margin="0,0,0,14" Text="-"/>
                    <TextBlock Style="{StaticResource Label}" Text="MEMORY GIVEN TO THE MACHINE"/>
                    <TextBlock x:Name="RvRam" Style="{StaticResource Body}" Margin="0,0,0,14" Text="-"/>
                    <TextBlock Style="{StaticResource Label}" Text="PROCESSORS"/>
                    <TextBlock x:Name="RvCpu" Style="{StaticResource Body}" Text="-"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Label}" Text="DISK"/>
                    <TextBlock x:Name="RvDisk" Style="{StaticResource Body}" Margin="0,0,0,14" Text="-"/>
                    <TextBlock Style="{StaticResource Label}" Text="SIGN IN AS"/>
                    <TextBlock x:Name="RvUser" Style="{StaticResource Body}" Margin="0,0,0,14" FontFamily="Consolas" Text="-"/>
                    <TextBlock Style="{StaticResource Label}" Text="ESTIMATED TIME"/>
                    <TextBlock x:Name="RvTime" Style="{StaticResource Body}" Text="-"/>
                  </StackPanel>
                </Grid>
              </Border>

              <ItemsControl x:Name="WarningList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#241E12" CornerRadius="7" Padding="14,11" BorderBrush="#4B3B1B"
                            BorderThickness="1" Margin="0,0,0,8">
                      <TextBlock Text="{Binding}" Foreground="#F0B84E" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Expander x:Name="AdvancedPanel" Header="Remove virtual machines already on this device"
                        Foreground="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12.5">
                <Border Background="#20141A" CornerRadius="7" Padding="16" BorderBrush="#5A2B33" BorderThickness="1" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="#FF9C93" TextWrapping="Wrap"
                               Text="AutoVM does not need to remove anything to build your machine. If you turn this on, it will delete the virtual machines and disk images it lists below. This cannot be undone."/>
                    <CheckBox x:Name="ChkTeardown" Margin="0,12,0,0" Content="Remove the machines listed below"/>
                    <ListBox x:Name="TeardownList" Height="96" Margin="0,10,0,0" Background="#0E1730"
                             Foreground="#E8EEF9" BorderBrush="{StaticResource Line}" FontFamily="Consolas" FontSize="11.5"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="TYPE DESTROY TO CONFIRM"/>
                    <TextBox x:Name="TxtDestroy" Width="220" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ========== 5 BUILD ========== -->
        <Grid x:Name="PageBuild" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="Building your machine"/>
            <TextBlock Style="{StaticResource Deck}" x:Name="BuildDeck"
                       Text="You can leave this running. Keep the computer awake and plugged in."/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <Border Height="8" Background="#0E1730" CornerRadius="4">
              <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource Accent}" CornerRadius="4"/>
            </Border>
            <Grid Margin="0,10,0,0">
              <TextBlock x:Name="BuildStatus" Style="{StaticResource Body}" FontSize="13" Text="Starting..."/>
              <TextBlock x:Name="BuildClock" Style="{StaticResource Body}" FontSize="12" FontFamily="Consolas"
                         Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Text="00:00:00"/>
            </Grid>
          </StackPanel>
          <Border Grid.Row="2" Background="#070C18" CornerRadius="8" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" Margin="0,0,0,20">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="14,12">
              <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#B9C7DE"
                       FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ========== 6 DONE ========== -->
        <Grid x:Name="PageDone" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Text="Your machine is ready"/>
            <TextBlock x:Name="DoneDeck" Style="{StaticResource Deck}" Text=""/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="264"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="20"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="DoneNote" Background="Transparent" BorderThickness="0" Foreground="#D6E1F2"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
            <StackPanel Grid.Column="1">
              <Button x:Name="BtnOpenPanel" Style="{StaticResource Primary}" Content="Open the control panel" HorizontalAlignment="Stretch"/>
              <Button x:Name="BtnOpenLogs" Content="Show the build log" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
              <Button x:Name="BtnCopyNote" Content="Copy these notes" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- ================= FOOTER ================= -->
      <Grid Grid.Row="1" Margin="0,0,0,24">
        <TextBlock x:Name="FooterNote" Foreground="#6C7DA0" FontSize="11.5" VerticalAlignment="Center" Text=""/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnBack" Content="Back" Margin="0,0,10,0" Width="112"/>
          <Button x:Name="BtnNext" Content="Continue" Style="{StaticResource Primary}" Width="168"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
